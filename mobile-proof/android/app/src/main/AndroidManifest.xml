<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only INTERNET is required for the HTTPS/TLS runtime proof. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FluxBarMobileProof"
        android:usesCleartextTraffic="false">

        <!-- Only the launcher Activity is exported. No services, receivers, -->
        <!-- providers, widgets, or media components are declared. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FluxBarMobileProof">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
